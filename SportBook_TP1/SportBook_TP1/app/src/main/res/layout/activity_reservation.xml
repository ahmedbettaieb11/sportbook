<?xml version="1.0" encoding="utf-8"?>
<!-- RACINE : LinearLayout vertical
     ⊃ RelativeLayout (en-tête)
     ⊃ LinearLayout (formulaire : EditText, CheckBox, boutons, ProgressBar) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="@color/primaire"
        android:padding="16dp">

        <ImageView
            android:id="@+id/imgCalendrier"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/resa_titre"
            android:src="@android:drawable/ic_menu_my_calendar" />

        <TextView
            android:id="@+id/tvTitreResa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@id/imgCalendrier"
            android:text="@string/resa_titre"
            android:textColor="@color/blanc"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvTitreResa"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@id/imgCalendrier"
            android:text="@string/resa_sous_titre"
            android:textColor="@color/primaire_clair" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <EditText
            android:id="@+id/editDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_date"
            android:inputType="date" />

        <EditText
            android:id="@+id/editHeure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/hint_heure"
            android:inputType="time" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_options"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/checkMateriel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/opt_materiel" />

        <CheckBox
            android:id="@+id/checkEclairage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/opt_eclairage" />

        <!-- Deux boutons côte à côte, même largeur (layout_weight) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRetour"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/btn_retour" />

            <Button
                android:id="@+id/btnReserver"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_reserver" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressResa"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvStatut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:textSize="16sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
