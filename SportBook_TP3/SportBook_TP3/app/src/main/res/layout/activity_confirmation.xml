<?xml version="1.0" encoding="utf-8"?>
<!-- NOUVELLE ACTIVITÉ 5 (TP2)
     RACINE : RelativeLayout
     ⊃ LinearLayout (carte récapitulative centrée)
     ⊃ LinearLayout horizontal (boutons Modifier / Confirmer collés en bas) -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond"
    android:padding="20dp">

    <LinearLayout
        android:id="@+id/carteConfirmation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="@drawable/bg_carte"
        android:orientation="vertical"
        android:padding="20dp">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/conf_titre"
            android:src="@android:drawable/ic_dialog_info" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="14dp"
            android:text="@string/conf_titre"
            android:textColor="@color/primaire"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView android:id="@+id/tvConfNom"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tvConfEmail"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />
        <TextView android:id="@+id/tvConfSport"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />
        <TextView android:id="@+id/tvConfJoueurs"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />
        <TextView android:id="@+id/tvConfTerrain"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />
        <TextView android:id="@+id/tvConfCreneau"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />
        <TextView android:id="@+id/tvConfDuree"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />
        <TextView android:id="@+id/tvConfOptions"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />
        <TextView android:id="@+id/tvConfTotal"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- TP3 : prix par joueur, calculé par PartageActivity (forResult) -->
        <TextView android:id="@+id/tvConfParJoueur"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/primaire"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnPartager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/btn_partager" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnModifier"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/btn_modifier" />

        <Button
            android:id="@+id/btnConfirmer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_confirmer" />
    </LinearLayout>
</RelativeLayout>
